# Copy this file to .env and fill in real values. Never commit .env.

# Per-task LLM routing: meta | baseten
VISION_PROVIDER=meta
AGENT_PROVIDER=meta
TEXT_PROVIDER=baseten

# Optional per-task reasoning effort; empty = parameter not sent
VISION_REASONING_EFFORT=low
AGENT_REASONING_EFFORT=
TEXT_REASONING_EFFORT=

# Per-task output budget; includes reasoning tokens
VISION_MAX_TOKENS=4000
AGENT_MAX_TOKENS=6000
TEXT_MAX_TOKENS=4000

# Meta Model API - model IDs from the dev.meta.ai docs
META_API_KEY=
META_BASE_URL=https://api.meta.ai/v1
META_VISION_MODEL=muse-spark-1.3
META_AGENT_MODEL=muse-spark-1.3
META_TEXT_MODEL=muse-spark-1.3
META_TRANSCRIBE_MODEL=muse-voice-transcribe-1.0
META_SEGMENT_MODEL=sam-3.1

# Baseten (Muse Spark Open) - one model for all tasks
BASETEN_API_KEY=
BASETEN_BASE_URL=https://inference.baseten.co/v1
BASETEN_MODEL=meta-models/muse-spark-open-1026

# Segmenter: sam31_api | sam3_modal
SEGMENTER=sam31_api

# Disk cache for model calls (relative to repo root)
CACHE_DIR=.cache
