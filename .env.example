# Copy this file to .env and fill in real values. Never commit .env.

# Per-task LLM routing: meta | baseten
VISION_PROVIDER=meta
AGENT_PROVIDER=meta
TEXT_PROVIDER=baseten

# Optional per-task reasoning effort; empty = parameter not sent
VISION_REASONING_EFFORT=low
AGENT_REASONING_EFFORT=
TEXT_REASONING_EFFORT=

# Per-task output budget; includes reasoning tokens
VISION_MAX_TOKENS=4000
AGENT_MAX_TOKENS=6000
TEXT_MAX_TOKENS=4000

# Meta Model API - model IDs from the dev.meta.ai docs
META_API_KEY=
META_BASE_URL=https://api.meta.ai/v1
META_VISION_MODEL=muse-spark-1.3
META_AGENT_MODEL=muse-spark-1.3
META_TEXT_MODEL=muse-spark-1.3
META_TRANSCRIBE_MODEL=muse-voice-transcribe-1.0
META_SEGMENT_MODEL=sam-3.1

# Baseten (Muse Spark Open) - one model for all tasks
BASETEN_API_KEY=
BASETEN_BASE_URL=https://inference.baseten.co/v1
BASETEN_MODEL=meta-models/muse-spark-open-1026

# Segmenter: sam31_api | sam3_modal
SEGMENTER=sam31_api

# Speech output: Meta MMS-TTS (CC-BY-NC 4.0, non-commercial), run locally on CPU
TTS_MODEL_EN=facebook/mms-tts-eng
TTS_MODEL_HI=facebook/mms-tts-hin
TTS_MODEL_MR=facebook/mms-tts-mar
# Speech input: languages that send keyword biasing to Muse Voice Transcribe (it hurt hi/mr)
ASR_KEYWORD_LANGUAGES=en

# API sessions
MAX_SESSIONS_PER_HOUR=30
SESSION_TTL_S=3600
MAX_VIDEO_S=45
MAX_VIDEO_MB=60
# Uploads are re-encoded with at most this long side (1920 keeps 1080p recordings at full size)
UPLOAD_LONG_SIDE=1920
SAMPLE_VIDEO=synthetic/videos/HH009/sweep.mp4
# Comma-separated; the deployed frontend's origin only
CORS_ORIGINS=http://localhost:5173

# Disk cache for model calls (relative to repo root)
CACHE_DIR=.cache

# Case files and login (Phase 9). Secrets: set in .env and in the Modal secret, never here.
DATABASE_URL=
PHONE_HASH_KEY=
TOKEN_SIGNING_KEY=
AUTH_MODE=demo
# production (the default): PHONE_HASH_KEY and TOKEN_SIGNING_KEY must be set, at least 32 bytes, or the app will
# not start. Set KAAGAZ_ENV=local in your .env for local runs (development keys are used if none are set).
KAAGAZ_ENV=
# Live-database tests (KAAGAZ_LIVE_DB=1 pytest -m live_db) use this database when set, else DATABASE_URL.
DATABASE_URL_TEST=
