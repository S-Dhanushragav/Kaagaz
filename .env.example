# Copy this file to .env and fill in real values. Never commit .env.

# Which LLM provider to use: meta | baseten
LLM_PROVIDER=baseten

# Meta Model API (Muse Spark, SAM 3.1, Voice Transcribe) - values from dev.meta.ai docs
META_API_KEY=
META_BASE_URL=
META_MODEL=

# Baseten (Muse Spark Open) - base URL from Baseten docs
BASETEN_API_KEY=
BASETEN_BASE_URL=
BASETEN_MODEL=meta-models/muse-spark-open-1026

# Segmenter: sam31_api | sam3_modal
SEGMENTER=sam31_api
